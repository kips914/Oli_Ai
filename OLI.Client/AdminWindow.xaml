<Window x:Class="OLI.Client.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OLI — пульт администратора" Width="1000" Height="760" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgWindowBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="🛰 Пульт администратора" FontSize="23" FontWeight="Bold"/>
            <TextBlock x:Name="AdminSubtitle" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,4,0,0"
                       Text="Сервер OLI на этом ПК: пользователи, квоты, доступ. Пароли хранятся только в виде PBKDF2-хеша."/>
        </StackPanel>

        <!-- Server card -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ServerDot" Width="10" Height="10" Margin="0,0,8,0"
                                 Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ServerStatusText" Text="Сервер: остановлен" FontWeight="SemiBold"
                                   FontSize="14"/>
                    </StackPanel>
                    <TextBlock x:Name="ServerDetailsText" Style="{StaticResource Caption}" Margin="18,6,0,0"
                               Text="Запустите сервер, чтобы телефон мог подключиться."/>
                    <TextBlock x:Name="ServerAddressText" Style="{StaticResource Caption}" Margin="18,4,0,0"
                               FontFamily="Cascadia Mono, Consolas" Text=""/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartServerButton" Content="▶ Запустить сервер" Click="StartServer_Click"
                            Style="{StaticResource AccentButton}" Height="34" Margin="0,0,8,0"/>
                    <Button x:Name="StopServerButton" Content="■ Остановить" Click="StopServer_Click"
                            Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                    <Button x:Name="RefreshUsersButton" Content="⟳" Click="Refresh_Click"
                            Style="{StaticResource IconButton}" ToolTip="Обновить список"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Users -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Пользователи" Style="{StaticResource SectionTitle}"/>
                <DataGrid x:Name="UsersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                          AlternatingRowBackground="{StaticResource BgInputBrush}"
                          Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5"
                          HorizontalGridLinesBrush="{StaticResource BorderBrush2}"
                          SelectionMode="Single" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Пользователь" Binding="{Binding UserName}" Width="*"/>
                        <DataGridTextColumn Header="Создан" Binding="{Binding CreatedText}" Width="130"/>
                        <DataGridTextColumn Header="Был(а)" Binding="{Binding LastLoginText}" Width="130"/>
                        <DataGridTextColumn Header="Занято" Binding="{Binding UsageText}" Width="150"/>
                        <DataGridTextColumn Header="Квота" Binding="{Binding QuotaText}" Width="90"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <Button x:Name="SetQuotaButton" Content="Изменить квоту" Click="SetQuota_Click"
                    Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
            <Button x:Name="ToggleUserButton" Content="Блок/разблок" Click="ToggleUser_Click"
                    Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
            <Button x:Name="ResetPasswordButton" Content="Сбросить пароль" Click="ResetPassword_Click"
                    Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
            <Button x:Name="DeleteUserButton" Content="Удалить" Click="DeleteUser_Click"
                    Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
            <Button x:Name="OpenStorageButton" Content="📂 Папки пользователей" Click="OpenStorage_Click"
                    Style="{StaticResource GhostButton}"/>
            <TextBlock x:Name="AdminMessageText" VerticalAlignment="Center" Margin="16,0,0,0"
                       Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
