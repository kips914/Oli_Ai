<Window x:Class="OLI.Client.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OLI — первая настройка"
        Height="620" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BgWindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Настройка OLI" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock x:Name="SubtitleText"
                       Text="Проверю компоненты и подключение. Это займёт около минуты и делается один раз."
                       Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}"/>
        </StackPanel>

        <!-- steps -->
        <Border Grid.Row="1" Margin="0,18,0,0" Padding="16,12"
                CornerRadius="10" Background="{DynamicResource BgPanelBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Шаги" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock x:Name="StepText" Text="1. Компоненты" Margin="0,6,0,0" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- log of what happens -->
        <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="10"
                Background="{DynamicResource BgInputBrush}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,10">
                <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="12.5"
                           TextWrapping="Wrap" LineHeight="19"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Text="Готово к проверке."/>
            </ScrollViewer>
        </Border>

        <!-- summary -->
        <Border x:Name="SummaryBorder" Grid.Row="3" Margin="0,12,0,0" Padding="14,10" CornerRadius="10"
                Background="{DynamicResource AccentSoftBrush}"
                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="13.5"
                       Text="Нажмите «Проверить и запустить»."/>
        </Border>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" x:Name="FixButton" Content="Исправить"
                    Visibility="Collapsed" Margin="0,0,8,0" Height="36"
                    Click="Fix_Click" Style="{StaticResource GhostButton}"/>
            <Button Grid.Column="2" x:Name="RetryButton" Content="Повторить"
                    Margin="0,0,8,0" Height="36" Click="Retry_Click"
                    Style="{StaticResource GhostButton}"/>
            <Button Grid.Column="3" x:Name="DoneButton" Content="Начать работу"
                    Height="36" MinWidth="150" Click="Done_Click" IsDefault="True"
                    IsEnabled="False" Style="{StaticResource AccentButton}"/>
        </Grid>
    </Grid>
</Window>
