<Window x:Class="OLI.Client.PasswordResetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сброс пароля" Width="440" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgWindowBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Text="Новый пароль" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                   Text="Задайте пользователю новый пароль. Старый восстановить нельзя: на сервере хранится только PBKDF2-хеш, а не сам пароль."/>
        <PasswordBox x:Name="PasswordBox1" Style="{StaticResource FieldPasswordBox}" Margin="0,0,0,8"/>
        <PasswordBox x:Name="PasswordBox2" Style="{StaticResource FieldPasswordBox}" Margin="0,0,0,8"/>
        <TextBlock x:Name="ErrorText" Style="{StaticResource Caption}" Foreground="{StaticResource OfflineBrush}"
                   Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Отмена" Click="Cancel_Click" Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0"/>
            <Button x:Name="OkButton" Content="Сохранить" Click="Ok_Click" Style="{StaticResource AccentButton}"
                    Height="32" MinWidth="100"/>
        </StackPanel>
    </StackPanel>
</Window>
