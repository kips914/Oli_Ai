<Window x:Class="OLI.Client.QuotaDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Квота пользователя" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgWindowBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="TitleText" Text="Квота" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,12"
                   Text="Сколько места на сервере может занимать пользователь (файлы и workspace)."/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Slider x:Name="QuotaSlider" Width="280" Minimum="64" Maximum="10240" TickFrequency="64"
                    IsSnapToTickEnabled="True" Style="{StaticResource FieldSlider}" VerticalAlignment="Center"/>
            <TextBlock x:Name="QuotaValueText" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Отмена" Click="Cancel_Click" Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0"/>
            <Button x:Name="OkButton" Content="Сохранить" Click="Ok_Click" Style="{StaticResource AccentButton}"
                    Height="32" MinWidth="100"/>
        </StackPanel>
    </StackPanel>
</Window>
