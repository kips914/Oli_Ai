<?xml version="1.0" encoding="utf-8"?>
<!-- The OLI server usually runs on the user's own PC over plain HTTP on a LAN/VPN. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
